@model MyBlog.Models.Article

<h1>Удалить статью</h1>

<p>Вы уверены, что хотите удалить эту статью?</p>

<div style="border: 1px solid #ccc; padding: 10px; margin: 10px 0;">
    <h3>@Model.Title</h3>
    <p>@Model.Excerpt</p>
</div>

<form action="/Admin/Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id">

    <button type="submit" style="background: red; color: white;">Удалить</button>
    <a href="/Admin" style="margin-left: 10px;">Отмена</a>
</form>
