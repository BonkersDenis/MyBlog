@model MyBlog.Models.Article

@{
    ViewData["Title"] = "Редактирование статьи";
}

<h1>Редактирование статьи</h1>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />

    <div asp-validation-summary="ModelOnly"></div>

    <div>
        <label asp-for="Title"></label>
        <input asp-for="Title" />
        <span asp-validation-for="Title"></span>
    </div>

    <div>
        <label asp-for="Excerpt"></label>
        <textarea asp-for="Excerpt"></textarea>
        <span asp-validation-for="Excerpt"></span>
    </div>

    <div>
        <label asp-for="Content"></label>
        <textarea asp-for="Content"></textarea>
        <span asp-validation-for="Content"></span>
    </div>

    <div>
        <label asp-for="PublishDate"></label>
        <input asp-for="PublishDate" type="datetime-local" />
        <span asp-validation-for="PublishDate"></span>
    </div>

    <button type="submit">Сохранить</button>
</form>

<a asp-action="Index">Назад к списку</a>