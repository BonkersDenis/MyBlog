@model List<MyBlog.Models.Article>

<h1>Панель управления</h1>

<a href="/Admin/Create">Создать новую статью</a>

<table border="1" cellpadding="10" style="width: 100%; margin-top: 20px;">
    <tr style="background: #e0e0e0;">
        <th>ID</th>
        <th>Заголовок</th>
        <th>Дата</th>
        <th>Действия</th>
    </tr>

    @foreach (var article in Model)
    {
        <tr>
            <td>@article.Id</td>
            <td>@article.Title</td>
            <td>@article.PublishDate.ToString("dd.MM.yyyy")</td>
            <td>
                <a href="/Admin/Edit/@article.Id">Редактировать</a> |
                <a href="/Admin/Delete/@article.Id">Удалить</a>
            </td>
        </tr>
    }
</table>